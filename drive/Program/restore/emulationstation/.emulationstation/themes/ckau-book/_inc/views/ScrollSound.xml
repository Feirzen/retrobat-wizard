<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
<!-- Custom scroll sound.
     THIS DRIVE'S VERSION (2026-09-25): every game list scrolls with the Wii U
     sound. The theme's own version plays a different sound per console.
     To use another sound, change wiiu.wav below (three places) to any file
     in _inc\sound\, then run Update Master Copies.bat. Switched on and off
     by 'scrollsound' in _Wizard\Settings\features.ini. -->
	<view name="system, menu, basic, detailed, grid, gamecarousel">
		<textlist name="gamelist">
			<scrollSound>${themePath}/_inc/sound/wiiu.wav</scrollSound>
			<storyboard>
				<sound path="${themePath}/_inc/sound/scroll-in.wav"/>
			</storyboard>
		</textlist>
		<gamecarousel name="gamecarousel">
			<scrollSound>${themePath}/_inc/sound/wiiu.wav</scrollSound>
			<storyboard>
				<sound path="${themePath}/_inc/sound/scroll-in.wav"/>
			</storyboard>
		</gamecarousel>
		<imagegrid name="gamegrid">
			<scrollSound>${themePath}/_inc/sound/wiiu.wav</scrollSound>
			<storyboard>
				<sound path="${themePath}/_inc/sound/scroll-in.wav"/>
			</storyboard>
		</imagegrid>
	</view>
</theme>